# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Data & model weights -- never commit, always DVC or download-on-demand
data/*
!data/README.md
*.pth
*.ckpt
*.h5

# Outputs -- regenerated by scripts, not source of truth. Ignore everything
# in this folder (plots, mlflow logs, per-patient checkpoint .npz files)
# rather than listing each file type -- anything landing here going forward
# is assumed regeneratable, not something to keep in git history.
outputs/*

# Stray debug logs from ad-hoc terminal runs (e.g. nohup ... > *.log)
*.log

# DVC cache (the .dvc/config and *.dvc pointer files ARE tracked)
.dvc/cache/
.dvc/tmp/

# LaTeX build artifacts -- regenerated by pdflatex, not source of truth
docs/*.aux
docs/*.out
docs/*.toc

# Env / secrets
.env

# OS / editor
.DS_Store
.ipynb_checkpoints/
.vscode/
